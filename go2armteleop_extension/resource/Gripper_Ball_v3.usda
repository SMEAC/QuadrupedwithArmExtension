                        }
                        displayGroup = "UV"
                        displayName = "Texture Scale"
                    )
                    float2 inputs:texture_translate = (0, 0) (
                        customData = {
                            float2 default = (0, 0)
                        }
                        displayGroup = "UV"
                        displayName = "Texture Translate"
                    )
                    token outputs:out
                }
            }
        }

