#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (500, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (115.66737415206447, 115.66737415206441, 115.66737151063005)
                double3 target = (-3.978037454999139e-8, -3.9780431393410254e-8, 7.956070646741864e-8)
            }
            dictionary Right = {
